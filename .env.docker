# Configuration pour Docker
# Copiez ce fichier vers .env et modifiez les valeurs selon votre configuration

# Base de données PostgreSQL (externe)
DB_DRIVER=postgres
DB_HOST=localhost  # ou l'adresse de votre serveur PostgreSQL
DB_PORT=5432
DB_NAME=appdaf
DB_USER=postgres
DB_PASS=your_password
DB_CHARSET=utf8

# Pour Docker en développement, utilisez:
# DB_HOST=host.docker.internal

# Pour Docker en production, utilisez l'adresse IP ou le nom d'hôte de votre serveur PostgreSQL
